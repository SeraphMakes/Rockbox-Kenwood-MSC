+static unsigned int kenwood_mbr_get_le32(const unsigned char *p)
+{
+    return (unsigned int)p[0]
+        | ((unsigned int)p[1] << 8)
+        | ((unsigned int)p[2] << 16)
+        | ((unsigned int)p[3] << 24);
