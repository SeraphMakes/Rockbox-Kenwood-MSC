+                       s->kenwood_pace_count,
+                       s->kenwood_pace_delay_us);
+
+    simplelist_addline("MF:%u>%u>%u",
+                       s->kenwood_frindex_before & 7,
+                       s->kenwood_frindex_after_delay & 7,
+                       s->kenwood_frindex_after_csw & 7);
