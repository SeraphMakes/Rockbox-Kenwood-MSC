+        value = kenwood_mbr_get_le32(&b[32]);
+        if(value != 0 && (value % mult) == 0)
+            kenwood_mbr_put_le32(&b[32], value / mult);
+
+        value = kenwood_mbr_get_le32(&b[36]);
+        if(value != 0 && (value % mult) == 0)
+            kenwood_mbr_put_le32(&b[36], value / mult);
